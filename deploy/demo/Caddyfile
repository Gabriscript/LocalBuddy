# Snippet for the server's existing Caddyfile. The hostname's DNS A/AAAA record must point at the
# server before the reload (Caddy fetches the certificate on first use).
#
# 8080 is API_PORT from .env. Caddy sends X-Forwarded-For and X-Forwarded-Proto on its own.

localbuddy.madhatworks.com {
	reverse_proxy 127.0.0.1:8080
}
