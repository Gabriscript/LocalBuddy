# Copy to .env next to compose.yaml and replace every CHANGE_ME. Never commit .env.

# Postgres password. Hex only: it goes inside a connection string, where ';' would break it.
#   openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# JWT signing key, at least 32 characters, never the one in appsettings.Development.json.
#   openssl rand -base64 48
JWT_KEY=CHANGE_ME

# Loopback port Caddy proxies to. Change it if 8080 is taken on the server.
API_PORT=8080

# Subnet of the compose network; the API believes forwarded headers only from it.
# Change it if it collides with a network already on the server.
DEMO_SUBNET=10.250.250.0/24
