<?xml version="1.0" encoding="utf-8" ?>
<!--
  Coverage for CRAP analysis: pass this file to dotnet test with the settings option, and collect
  "XPlat Code Coverage" into TestResults/. OpenCover is the format that carries cyclomatic
  complexity per method.

  CompilerGeneratedAttribute is deliberately NOT excluded: async methods compile to generated
  state machines, so excluding it drops nearly every controller action and reports 52% coverage
  where the truth was 18%.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura,opencover</Format>
          <Exclude>[*.Tests]*</Exclude>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/obj/**/*,**/*.g.cs,**/*.designer.cs,**/Migrations/**/*</ExcludeByFile>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
